// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  SUPERADMIN
}

enum OrderStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  email     String?   
  username  String    @unique
  password  String
  role      Role      @default(USER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  eggLogs        EggLog[]
  orders         EggShopOrder[] @relation("OrdersByUser")
  approvedOrders EggShopOrder[] @relation("OrdersApproved")
  
  @@map("users")
}

model EggCount {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  count       Int      @default(0)
  lastUpdated DateTime @default(now()) @updatedAt
  
  @@map("egg_counts")
}

model EggLog {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  action        String   // INCREMENT, REDUCE_EGGS, REDUCE_RACKS
  previousCount Int
  newCount      Int
  userId        String?  @db.ObjectId
  user          User?    @relation(fields: [userId], references: [id])
  createdAt     DateTime @default(now())
  
  @@map("egg_logs")
}

model EggShopOrder {
  id             String      @id @default(auto()) @map("_id") @db.ObjectId
  userId         String      @db.ObjectId
  user           User        @relation("OrdersByUser", fields: [userId], references: [id])
  phoneNumber    String
  count          Int         // Jumlah telur (butir) atau jumlah rak
  orderType      String      // "BUTIR" atau "RAK"
  status         OrderStatus @default(PENDING)
  approvedById   String?     @db.ObjectId
  approvedBy     User?       @relation("OrdersApproved", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  rejectedReason String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@map("egg_shop_orders")
}

model OtpVerification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String
  username  String
  password  String
  otpCode   String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("otp_verifications")
}
